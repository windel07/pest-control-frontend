{
  "include": [
    "./typed-router.d.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets/*": [
        "src/assets/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@/*": [
        "src/*"
      ],
      "@modules/*": [
        "src/modules/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@app/*": [
        "src/components/app/*"
      ],
      "@auth/*": [
        "src/components/auth/*"
      ],
      "@base/*": [
        "src/components/base/*"
      ],
      "@composables/*": [
        "src/composables/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@dashboard/*": [
        "src/components/dashboard/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@stores/*": [
        "src/stores/*"
      ],
      "@misc/*": [
        "src/components/misc/*"
      ],
      "@datas/*": [
        "src/datas/*"
      ],
      "@directives/*": [
        "src/directives/*"
      ]
    }
  }
}