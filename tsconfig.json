{
  "include": [
    "./typed-router.d.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets/*": [
        "src/assets/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@/*": [
        "src/*"
      ],
      "@modules/*": [
        "src/modules/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@app/*": [
        "src/components/app/*"
      ],
      "@auth/*": [
        "src/components/auth/*"
      ]
    }
  }
}